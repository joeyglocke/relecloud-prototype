# Bot Framework / Entra app credentials.
#
# Teams CLI (`teams app create --name "Relecloud" --env .env`) writes
# these three keys automatically. The bot's index.ts and the packager
# both read either CLIENT_*/TENANT_* (CLI convention) or BOT_ID/BOT_PASSWORD
# (manual setup).
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Optional — only set if the manifest's `id` should differ from CLIENT_ID.
# Teams-managed bots reuse CLIENT_ID for both, so leaving this blank is
# usually correct.
# TEAMS_APP_ID=

# Port the agent listens on. Default matches the Teams quickstart.
PORT=3978
