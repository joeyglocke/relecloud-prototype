# Bot Framework credentials. The Teams CLI writes these for you when you run
# `teams app create --name "Relecloud" --env .env` — but you can also paste in
# values from an existing Azure Bot resource. The bot will fall back to
# unauthenticated mode for local-only experimentation if both are empty.
BOT_ID=
BOT_PASSWORD=

# Port the agent listens on. Default matches the Teams quickstart.
PORT=3978
